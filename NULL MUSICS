				if writefile then
					writefile(track.file, data)
				end
			end

			local getAsset = getAssetFunction()
			if not getAsset then
				error("No getcustomasset / getsynasset")
			end

			local asset = getAsset(track.file)
			assetCache[track.file] = asset
			loaded[track.file] = true
			return asset
		end)

		return success, result
	end


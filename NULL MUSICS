					btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				else
					btn.BackgroundColor3 = Color3.fromRGB(16, 13, 26)
					btn.TextColor3 = Color3.fromRGB(220, 200, 235)
				end
			end
		end
	end

	local function playTrack(track, button, index)
		playToken += 1
		local token = playToken

		-- Toggle off if same track is playing
		if currentFile == track.file and sound.IsPlaying then
			pcall(function() sound:Stop() end)
			currentFile = nil
			highlight(nil)
			updateActiveButton(false)
			return
		end

		if loaded[track.file] and assetCache[track.file] then
			pcall(function() sound:Stop() end)
			sound.SoundId = assetCache[track.file]
			sound.PlaybackSpeed = clampSpeed(Settings.MusicSpeed)
			sound:Play()
			currentFile = track.file
			selectedIndex = index
			highlight(index)
			updateActiveButton(true)
			return
		end

		if button then
			button.Text = "Loading..."
		end

		task.spawn(function()
			local ok, asset = loadTrack(track)
			if token ~= playToken then return end

			if ok and asset then
				pcall(function() sound:Stop() end)
				sound.SoundId = asset
				sound.PlaybackSpeed = clampSpeed(Settings.MusicSpeed)
				sound:Play()
				currentFile = track.file
				selectedIndex = index
				highlight(index)
				updateActiveButton(true)
			elseif button then
				button.Text = "Failed"
				task.wait(1.2)
				if token == playToken and button:GetAttribute("OrigName") then
					button.Text = button:GetAttribute("OrigName")
				end
			end
		end)
	end


-- Helpers
local function getAssetFunction()
	return getcustomasset or getsynasset
end

local function getParent()
	if gethui then
		local ok, result = pcall(gethui)
		if ok and result then return result end
	end
	return PlayerGui
end

local function makeDraggable(frame, handle)
	local dragging = false
	local dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function clampSpeed(value)
	value = tonumber(value) or 1
	return math.clamp(math.floor(value * 10 + 0.5) / 10, 0.5, 2)
end

local function clampScale(value)
	value = tonumber(value) or 1
	return math.clamp(math.floor(value * 20 + 0.5) / 20, 0.7, 1.5)
end


--==================================================
-- PLAY / PAUSE
--==================================================

Play.MouseButton1Click:Connect(function()
	local Songs = Music[CurrentTab]
	local Data = Songs[CurrentIndex]
	if not Data or ((not Data.Url or Data.Url == "") and (not Data.AssetId or Data.AssetId == "")) then return end

	if Playing then
		Sound:Pause()
		Playing = false
		Play.Text = "▶"
	else
		if Sound.SoundId == "" then
			LoadSong(CurrentIndex, true)
		else
			if Sound.TimePosition > 0 then
				Sound:Resume()
			else
				Sound:Play()
			end
		end
		Playing = true
		Play.Text = "Ⅱ"
	end
end)


--==================================================
-- LOAD SONG (STABLE URL HANDLER)
--==================================================

local function GetAsset(Url)
	if Url == "" then return "" end
	
	if writefile and readfile and (getcustomasset or getsynasset) then
		local fileName = "nullmusic_" .. math.random(10000, 99999) .. ".mp3"
		local success, data = pcall(function() return game:HttpGet(Url) end)
		if success and data then
			local writeSuccess = pcall(function() writefile(fileName, data) end)
			if writeSuccess then
				local getAssetFunc = getcustomasset or getsynasset
				local assetSuccess, result = pcall(function() return getAssetFunc(fileName) end)
				if assetSuccess and result then
					return result
				end
			end
		end
	end
	
	return Url
end

local function LoadSong(Index, AutoPlay)
	local Songs = Music[CurrentTab]
	if not Songs[Index] then return end

	CurrentIndex = Index
	local Data = Songs[Index]
	CurrentSong.Text = "♪ " .. Data.Name

	Sound:Stop()
	
	if Data.AssetId and Data.AssetId ~= "" then
		Sound.SoundId = Data.AssetId
	elseif Data.Url and Data.Url ~= "" then
		Sound.SoundId = GetAsset(Data.Url)
	else
		Sound.SoundId = ""
	end

	if AutoPlay and Sound.SoundId ~= "" then
		Sound:Play()
		Playing = true
		Play.Text = "Ⅱ"
	else
		Playing = false
		Play.Text = "▶"
	end
end

